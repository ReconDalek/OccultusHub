{
  "name": "occultushub-worker",
  "version": "1.0.0",
  "description": "occultusHub admin backend - Cloudflare Workers",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "predeploy": "if exist ..\\.wrangler rd /s /q ..\\.wrangler",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute occultusdb --file=src/db/schema.sql --remote",
    "db:migrate": "wrangler d1 execute occultusdb --file=src/db/migration_add_cache_support.sql --remote",
    "db:query": "wrangler d1 execute occultusdb --interactive"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.0"
  },
  "devDependencies": {
    "wrangler": "^4.95.0"
  }
}
